{
  "name": "@zjfcool/graph-vis",
  "version": "0.2.0-beta.4",
  "description": "A high-performance graph visualization library built on PixiJS.",
  "keywords": [
    "graph",
    "graph-vis",
    "pixi.js",
    "visualization"
  ],
  "license": "MIT",
  "author": "zjfcool",
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "type": "module",
  "main": "esm/index.js",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "unpkg": "dist/graph-vis.min.js",
  "jsdelivr": "dist/graph-vis.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "release": "bumpp",
    "lint:fmt": "oxfmt",
    "lint": "oxlint",
    "prepare": "lefthook install",
    "lint:cspell": "cspell .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "bezier-js": "^6.1.4",
    "d3-color": "^3.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "events": "^3.3.0",
    "graphology": "^0.26.0",
    "tiny-typed-emitter": "^2.1.0"
  },
  "devDependencies": {
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@types/bezier-js": "^4.1.3",
    "@types/d3-color": "^3.1.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "bumpp": "^11.1.0",
    "cspell": "^9.8.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "pixi.js": "^8.19.0",
    "tsdown": "^0.22.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "pixi.js": ">=8"
  }
}
