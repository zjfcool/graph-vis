{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-var": "error",
    "no-unused-vars": "error",
    "no-console": [
      "warn",
      {
        "allow": ["error", "warn", "time", "timeEnd"]
      }
    ],
    "import/no-cycle": ["error", { "maxDepth": 3 }]
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".lefthook/**",
    "esm/**",
    "examples/**",
    "*.json"
  ],
  "env": {
    "builtin": true
  }
}
